                </div>
            </div>
        </div>
    </a>

    <a href="#" class="card print">
        <div class="card-top">
            <div class="icon">🖨️</div>
            <div>
                <div class="title">IMPRESSION</div>
                <div class="desc">
                    Documents clients<br>
                    QR Code Wi-Fi<br>
                    Couleur / N&B
                </div>
            </div>
        </div>
    </a>

    <a href="#" class="card history">
        <div class="card-top">
            <div class="icon">🧾</div>
            <div>
                <div class="title">HISTORIQUE</div>
                <div class="desc">
                    Recherche ventes<br>
                    Réimpression<br>
                    Filtres avancés
                </div>
            </div>
        </div>
    </a>

    <a href="#" class="card lots">
        <div class="card-top">
            <div class="icon">🗂️</div>
            <div>
                <div class="title">LOTS</div>
                <div class="desc">
                    Achat de lots<br>
