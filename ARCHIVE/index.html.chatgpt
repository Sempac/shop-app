    <a href="#" class="card returns">
        <div class="card-top">
            <div class="icon">↩️</div>
            <div>
                <div class="title">RETOURS</div>
                <div class="desc">
                    Retours clients<br>
                    Retours fournisseur<br>
                    Stock inutilisable
                </div>
            </div>
        </div>
    </a>

    <a href="#" class="card credits">
        <div class="card-top">
            <div class="icon">💳</div>
            <div>
                <div class="title">CRÉDITS</div>
                <div class="desc">
                    Dettes clients<br>
