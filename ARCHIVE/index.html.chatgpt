    <div class="separator"></div>

    <div class="right-date">

        <div class="day" id="day">
            LUNDI
        </div>

        <div class="week" id="week">
            📅 Semaine 20
        </div>

        <div class="sync">
            🔄 Synchronisation active
        </div>

    </div>

</div>

<!-- =========================
     MAIN
========================= -->

<div class="main">

    <a href="#" class="card sales">
        <div class="card-top">
            <div class="icon">⚡</div>
            <div>
                <div class="title">VENTES</div>
                <div class="desc">
                    Caisse rapide<br>
                    Paiement mixte<br>
                    Ticket / Facture
                </div>
            </div>
        </div>
    </a>

    <a href="#" class="card repairs">
